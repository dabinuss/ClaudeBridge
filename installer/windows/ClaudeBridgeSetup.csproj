<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClaudeBridge-Setup-Windows</AssemblyName>
    <RootNamespace>ClaudeBridge.Setup</RootNamespace>
    <Version>2.5.0</Version>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="ClaudeBridge.Payload" />
  </ItemGroup>
</Project>
